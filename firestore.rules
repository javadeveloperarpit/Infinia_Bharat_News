rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    function isLoggedIn(){

      return request.auth != null;

    }


    function getUserRole(){

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;

    }


    function isAdmin(){

      return isLoggedIn()
      &&
      getUserRole() == "admin";

    }


    function isEditor(){

      return isLoggedIn()
      &&
      (
        getUserRole() == "admin"
        ||
        getUserRole() == "editor"
      );

    }



    // Articles

    match /articles/{articleId} {


      allow read:
        if resource.data.status == "published";


      allow create, update, delete:
        if isEditor();

    }



    // Categories

    match /categories/{categoryId} {


      allow read: 
        if true;


      allow write:
        if isAdmin();

    }



    // Videos

    match /videos/{videoId} {


      allow read:
        if resource.data.status == "published";


      allow write:
        if isEditor();

    }



    // Users

    match /users/{userId} {


      allow read:
        if isLoggedIn();


      allow write:
        if isAdmin();

    }



    // Ads

    match /ads/{adId} {


      allow read:
        if resource.data.active == true;


      allow write:
        if isAdmin();

    }



    // Settings

    match /settings/{settingId} {


      allow read:
        if true;


      allow write:
        if isAdmin();

    }


  }

}